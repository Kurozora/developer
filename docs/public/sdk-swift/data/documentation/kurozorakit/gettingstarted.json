"let kurozoraKit = KurozoraKit()"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"KurozoraKit allows you to set your own API endpoint. For example, if you have a custom API endpoint for debugging purposes, you can set it like this:","type":"text"}]},{"code":["let kurozoraKit = KurozoraKit(apiEndpoint: .custom(\"https:\/\/kurozora.debug\/api\/\"))"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"KurozoraKit also accepts a "},{"type":"codeVoice","code":"KKServices"},{"text":" object to enable and manage extra functionality. For example to manage Keychain data you can do something like the following:","type":"text"}]},{"type":"codeListing","code":["\/\/ Prepare Keychain with your desired setting.","let appIdentifierPrefix = Bundle.main.infoDictionary?[\"AppIdentifierPrefix\"] as! String","let keychain = Keychain(service: app_name, accessGroup: \"\\(appIdentifierPrefix)com.company.shared\")","\t.synchronizable(true)","\t.accessibility(.afterFirstUnlock)","","\/\/ Pass the keychain object.","let services = KKServices(keychain: keychain)","","\/\/ Pass KKService","let kurozoraKit = KurozoraKit(authenticationKey: bearer_token).services(services)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can also be chain desired methods instead of passing data as parameter."}]},{"type":"codeListing","code":["let services = KKServices().keychainDefaults(keychain)","let kurozoraKit = KurozoraKit()","\t.authenticationKey(bearer_token)","\t.services(services)"],"syntax":"swift"},{"type":"heading","text":"Making API Requests","level":2,"anchor":"Making-API-Requests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once KurozoraKit is initialized, you can start making API requests."}]},{"level":3,"text":"Retrieve Explore Data","type":"heading","anchor":"Retrieve-Explore-Data"},{"inlineContent":[{"type":"text","text":"To retrieve data for the explore page, use the getExplore method with a specified genre ID:"}],"type":"paragraph"},{"syntax":"swift","code":["let genreID = \"1234\"","","do {","\tlet exploreCategoryResponse = try await kurozoraKit.getExplore(genreID: genreID).value","\tprint(exploreCategoryResponse.data)","} catch {","\tprint(\"Failed to fetch explore: \\(error)\")","\t\/\/ Handle error case…","}"],"type":"codeListing"},{"level":3,"text":"Retrieve User Profile","type":"heading","anchor":"Retrieve-User-Profile"},{"inlineContent":[{"type":"text","text":"To retrieve a user’s profile using their ID, you can use the following:"}],"type":"paragraph"},{"style":"note","name":"Note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"You don’t usually need to create a "},{"type":"reference","identifier":"doc:\/\/kurozorakit.KurozoraKit\/documentation\/KurozoraKit\/UserIdentity","isActive":true},{"type":"text","text":" object directly; you can get it from other API calls, such as when using "},{"type":"reference","identifier":"doc:\/\/kurozorakit.KurozoraKit\/documentation\/KurozoraKit\/KurozoraKit\/getFollowList(forUser:_:next:limit:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"syntax":"swift","code":["let userIdentity = UserIdentity(id: \"12345\")","","do {","\tlet userProfileResponse = try await kurozoraKit.getDetails(forUser: userIdentity).value","\tprint(userProfileResponse.data)","} catch {","\tprint(\"Failed to fetch user profile: \\(error)\")","\t\/\/ Handle error case…","}"],"type":"codeListing"},{"level":3,"text":"Search for Content","type":"heading","anchor":"Search-for-Content"},{"inlineContent":[{"type":"text","text":"KurozoraKit provides a search API to find anime, manga, games, and more based on keywords:"}],"type":"paragraph"},{"syntax":"swift","code":["let searchQuery = \"Re:Zero\"","let scope = KKSearchScope.kurozora","let types = [KKSearchType.show]","","do {","\tlet searchResponse = try await kurozoraKit.search(scope, of: types, for: query).value","\tp